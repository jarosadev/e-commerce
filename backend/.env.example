# App
NODE_ENV=development
PORT=4000
PLATFORM_NAME="Vendexa SaaS"
PLATFORM_BASE_DOMAIN="localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# PostgreSQL (Docker Compose port 5433)
DATABASE_URL="postgresql://ecommerce_admin:ecommerce_secret_2026@localhost:5433/ecommerce_saas?schema=public"

# Redis (Cache + BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT & OAuth Broker Security
JWT_ACCESS_SECRET="dev_jwt_access_secret_change_in_prod_2026_min_32_chars"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_in_prod_2026_min_32_chars"
OAUTH_STATE_SECRET="dev_oauth_broker_state_secret_2026_min_32_chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Google OAuth 2.0 (Central Auth Broker: http://localhost:4000/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Email / Transactional Mail (Mailpit local SMTP by default; Resend SMTP in prod)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="Vendexa E-Commerce"
MAIL_FROM_ADDRESS="no-reply@vendexa.local"

# S3 / Cloudflare R2 Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="any"
S3_SECRET_KEY="any"
S3_PUBLIC_BUCKET="catalog-public"
S3_PRIVATE_BUCKET="receipts-private"
S3_PUBLIC_BASE_URL="http://localhost:9000/catalog-public"

# SaaS Billing Gateways (Optional in local dev -> runs in non-blocking sandbox mode if omitted)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
SUBSCRIPTION_GRACE_DAYS=5
SUBSCRIPTION_REMINDER_DAYS=3
